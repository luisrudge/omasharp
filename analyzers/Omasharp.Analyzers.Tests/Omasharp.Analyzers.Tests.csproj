<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for Omasharp.Analyzers: compiles small backends in memory and checks what each rule
       reports. Run it from the repo root with dotnet run and the project path. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The tests' stand-in for CA1822 is a throwaway analyzer: the rules for shipped analyzers
         (reserved ids, release tracking, concurrency) don't apply to it. -->
    <NoWarn>$(NoWarn);RS1036;RS1029;RS2008;RS1026</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <ProjectReference Include="../Omasharp.Analyzers/Omasharp.Analyzers.csproj" />
  </ItemGroup>
</Project>
