    <!-- window: Main.qml in a native window. panel: plugin/Panel.qml inside omarchy-shell. -->
    <OmarchyKind>omarchy-kind</OmarchyKind>
    <!-- The Wayland app_id (window rules match on it) or the shell plugin id. -->
    <AppId>omarchy-app-id</AppId>
    <AppName>OmarchyApp</AppName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>
  <!-- The bridge: copied into this app, yours to read and change. See bridge/README.md. -->
  <Import Project="bridge/Omasharp.targets" />
</Project>
