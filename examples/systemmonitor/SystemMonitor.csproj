<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OmarchyKind>window</OmarchyKind>
    <!-- Its own app_id, so it never replaces an app you made from the template with the same name. -->
    <AppId>omasharp-systemmonitor</AppId>
    <AppName>System Monitor</AppName>
    <!-- This repo's analyzers, from source (apps get the Omasharp.Analyzers package). -->
    <OmasharpAnalyzersProject>$(MSBuildThisFileDirectory)../../analyzers/Omasharp.Analyzers/Omasharp.Analyzers.csproj</OmasharpAnalyzersProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>
  <Import Project="../../template/bridge/Omasharp.targets" />
</Project>
