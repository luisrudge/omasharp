<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Backend.cs: plain C#, no Qt, no window. Run from the app folder: dotnet run (project: tests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app's C# plus this repo's bridge (its window/panel transports compile away here). -->
    <Compile Include="../Backend.cs;../../../template/bridge/cs/*.cs" />
  </ItemGroup>
</Project>
